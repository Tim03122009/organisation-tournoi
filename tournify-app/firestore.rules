rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwnerPath(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isListedAdmin() {
      return isSignedIn() && (
        request.auth.uid in resource.data.adminUids
      );
    }

    match /userDirectory/{email} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn()
        && request.resource.data.uid == request.auth.uid;
    }

    match /tournamentAccess/{accessId} {
      allow read: if isSignedIn() && (
        resource.data.uid == request.auth.uid ||
        resource.data.ownerUid == request.auth.uid
      );
      allow create: if isSignedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.role == "admin";
      allow update: if isSignedIn() && resource.data.ownerUid == request.auth.uid;
      allow delete: if isSignedIn() && (
        resource.data.uid == request.auth.uid ||
        resource.data.ownerUid == request.auth.uid
      );
    }

    match /users/{userId}/tournaments/{tournamentId} {
      allow read: if isOwnerPath(userId) || isListedAdmin();
      allow create: if isOwnerPath(userId);
      allow update: if (isOwnerPath(userId) || isListedAdmin())
        && request.resource.data.ownerUid == resource.data.ownerUid;
      allow delete: if isOwnerPath(userId);
    }

    match /users/{userId}/{document=**} {
      allow read, write: if isOwnerPath(userId);
    }
  }
}
